enum UserRole {
  SUPER_ADMIN
  ADMIN
  CASHIER
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  name                  String
  role                  UserRole @default(CASHIER)
  isActive              Boolean  @default(true)
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  posts                 Post[]
}